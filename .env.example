# Konfigurasi opsional - aplikasi berjalan penuh dengan localStorage tanpa variabel ini.
# Isi hanya jika ingin menyimpan data ke Supabase (multi-user).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Catatan: JANGAN pernah menaruh service_role key / secret key di frontend.
# Jalankan supabase/schema.sql di SQL Editor Supabase untuk membuat tabel + RLS.
